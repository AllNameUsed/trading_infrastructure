# API Keys and Secrets
.env

# Databases (Proprietary Trading Data)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Execution Logs
*.log
sys.log

# Kill switch operator files (runtime state, never versioned)
config/kill_switch.ini
config/kill_switch_status.txt
config/kill_switch_status.tmp

# Python Environments and Cache
venv/
__pycache__/
*.pyc

# Ignore everything inside the strategies folder
strategies/*

# Whitelist only the structural and mock files
!strategies/base.py
!strategies/mock_strat.py
!strategies/__init__.py